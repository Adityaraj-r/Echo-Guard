ENVIRONMENT=development
API_TITLE=EchoGuard API
API_VERSION=2.0.0

MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=echoguard

# Local development deletion is enabled; production Compose disables it by default.
ENABLE_DETECTION_DELETE=true
ALLOW_UNTRAINED_MODEL=false

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

UPLOAD_DIR=uploads
TEMP_AUDIO_DIR=temp_audio
TEMP_IMAGE_DIR=temp_images
MAX_UPLOAD_SIZE_MB=25

FFMPEG_PATH=
FFPROBE_PATH=
MODEL_WEIGHTS_PATH=echoguard_weights.pth
MODEL_FAKE_CLASS_INDEX=0
MODEL_HUMAN_CLASS_INDEX=1
# Keep NEW's linear-STFT model image path unless legacy checkpoint provenance is verified.
MODEL_SPECTROGRAM_MODE=new
MODEL_FAKE_THRESHOLD=0.65
MODEL_HUMAN_THRESHOLD=0.35
MODEL_TEMPERATURE=2.5
MODEL_FUSION_CNN_WEIGHT=0.35
MODEL_LEGACY_ONLY_CNN_WEIGHT=0.2
ENHANCED_MODEL_WEIGHTS_PATH=echoguard_hybrid_weights.pth
CALIBRATION_PATH=calibration.json

# Docker Compose credentials (replace every placeholder with URL-safe secrets).
# The Compose stack uses a separate restricted application user for the API.
# The Mongo initialization script runs only when mongo-data is first created.
# Base Compose exposes the frontend only; add docker-compose.dev.yml for localhost API/Mongo ports.
MONGO_INITDB_ROOT_USERNAME=echoguard_admin
MONGO_INITDB_ROOT_PASSWORD=REPLACE_WITH_URL_SAFE_SECRET
MONGO_APP_USERNAME=echoguard_app
MONGO_APP_PASSWORD=REPLACE_WITH_URL_SAFE_SECRET

# Compose/browser settings. Set these to the actual deployment origin and hostnames.
DOCKER_CORS_ORIGINS=http://localhost:8080
DOCKER_ALLOWED_HOSTS=localhost,127.0.0.1,api
# Retains the previous Compose fake threshold; this value is not scientifically validated.
PRODUCTION_MODEL_FAKE_THRESHOLD=0.75
PRODUCTION_MODEL_HUMAN_THRESHOLD=0.35
PRODUCTION_ENABLE_DETECTION_DELETE=false
